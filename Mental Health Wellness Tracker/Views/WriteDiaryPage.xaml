<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mental_Health_Wellness_Tracker.ViewModels"
             x:Class="Mental_Health_Wellness_Tracker.WriteDiaryPage"
             NavigationPage.HasNavigationBar="False">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextCyan">#00E5FF</Color>
            <Color x:Key="ActiveNavColor">#689FBD</Color>
            <LinearGradientBrush x:Key="MoodGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DeepSkyBlue" Offset="0.0" />
                <GradientStop Color="Navy" Offset="1.5" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="InputGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="DeepSkyBlue" Offset="0.0" />
                <GradientStop Color="Navy" Offset="1.5" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="UploadGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DeepSkyBlue" Offset="0.0" />
                <GradientStop Color="Navy" Offset="1.5" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DeepSkyBlue" Offset="0.0" />
                <GradientStop Color="Navy" Offset="1.5" />
            </LinearGradientBrush>

            <Style TargetType="ImageButton" x:Key="MoodEmojiStyle">
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="Command" Value="{Binding MoodEmojiClickedCommand}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger TargetType="ImageButton" 
                                 Binding="{Binding Source={RelativeSource Self}, Path=CommandParameter}" 
                                 Value="{Binding SelectedMoodEmoji}">
                        <Setter Property="BorderColor" Value="Yellow"/>
                        <Setter Property="BorderWidth" Value="3"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill"/>

        <Grid RowDefinitions="*, 80">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="15" Padding="20,20,20,20">

                    <Label Text="WRITE DIARY" FontFamily="BrushFont" FontSize="35" TextColor="{StaticResource TextCyan}" HorizontalOptions="Center" Margin="0,10,0,5"/>

                    <Label Text="How are you feeling today?" TextColor="White" FontAttributes="Bold, Italic" HorizontalOptions="Center"/>

                    <Border StrokeShape="RoundRectangle 25" Background="{StaticResource MoodGradient}" StrokeThickness="0" HeightRequest="60" Padding="10">
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <ImageButton Grid.Column="0" Source="emoji_dead.png" CommandParameter="emoji_dead.png" Style="{StaticResource MoodEmojiStyle}"/>
                            <ImageButton Grid.Column="1" Source="emoji_sad.png" CommandParameter="emoji_sad.png" Style="{StaticResource MoodEmojiStyle}"/>
                            <ImageButton Grid.Column="2" Source="emoji_neutral.png" CommandParameter="emoji_neutral.png" Style="{StaticResource MoodEmojiStyle}"/>
                            <ImageButton Grid.Column="3" Source="emoji_smile.png" CommandParameter="emoji_smile.png" Style="{StaticResource MoodEmojiStyle}"/>
                            <ImageButton Grid.Column="4" Source="emoji_love.png" CommandParameter="emoji_love.png" Style="{StaticResource MoodEmojiStyle}"/>
                        </Grid>
                    </Border>

                    <Label Text="What's On Your Mind?" TextColor="White" FontAttributes="Bold, Italic" HorizontalOptions="Center" Margin="0,10,0,0"/>

                    <Border StrokeShape="RoundRectangle 20" Background="{StaticResource InputGradient}" StrokeThickness="0" HeightRequest="150" Padding="15">
                        <Editor x:Name="TxtDiaryEntry" Text="{Binding DiaryEntryText}" Placeholder="Type Here..." PlaceholderColor="#33000000" TextColor="Black" AutoSize="TextChanges" BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Upload Photos (Optional)" TextColor="White" FontAttributes="Bold, Italic" HorizontalOptions="Center" Margin="0,10,0,0"/>

                    <Border StrokeShape="RoundRectangle 25" Background="{StaticResource UploadGradient}" StrokeThickness="0" HeightRequest="150" Padding="15">
                        <Grid RowDefinitions="Auto, *">
                            <Button Grid.Row="0" Text="Add Photos" TextColor="Black" BackgroundColor="#E0E0E0" CornerRadius="5" HeightRequest="40" FontSize="12" 
                                HorizontalOptions="Start" Command="{Binding UploadImagesCommand}"/>

                            <CollectionView Grid.Row="1" ItemsSource="{Binding SelectedImages}" ItemsLayout="HorizontalList" Margin="0,5,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 5" StrokeThickness="0" Margin="0,0,10,0" HeightRequest="50" WidthRequest="50">
                                            <Image Source="{Binding .}" Aspect="AspectFill"/>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>

                    <Button Text="Post to Community" FontAttributes="Bold, Italic" 
                            FontSize="20" TextColor="White" Background="{StaticResource ButtonGradient}" CornerRadius="30" HeightRequest="60" Margin="0,30,0,20" Command="{Binding PostCommand}"/>

                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" Padding="10,0">
                <Grid ColumnDefinitions="*,*,*,*,*">
                    <Button Grid.Column="0" ImageSource="nav_community.png" Command="{Binding NavigateCommand}" CommandParameter="Community" AutomationId="Community" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                    <Button Grid.Column="1" ImageSource="nav_list.png" Command="{Binding NavigateCommand}" CommandParameter="List" AutomationId="List" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                    <Button Grid.Column="2" ImageSource="nav_diary.png" Command="{Binding NavigateCommand}" CommandParameter="Diary" AutomationId="Diary" BackgroundColor="{StaticResource ActiveNavColor}" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                    <Button Grid.Column="3" ImageSource="nav_graph.png" Command="{Binding NavigateCommand}" CommandParameter="Stats" AutomationId="Stats" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                    <Button Grid.Column="4" ImageSource="nav_profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" AutomationId="Profile" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>