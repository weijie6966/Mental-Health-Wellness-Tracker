<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mental_Health_Wellness_Tracker.ViewModels"
             xmlns:models="clr-namespace:Mental_Health_Wellness_Tracker.Models"
             x:Class="Mental_Health_Wellness_Tracker.Views.AssessmentPage"
             Title="Mental Health Assessment"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="background.png">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextCyan">#00E5FF</Color>
            <Color x:Key="ActiveNavColor">#689FBD</Color>
            <Color x:Key="CommentBGColor">#181E3F</Color>
            <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9F55FF" Offset="0.0" />
                <GradientStop Color="#00E5FF" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="AssessmentContent" RowDefinitions="*, Auto" Padding="0">

        <Image Source="background.png" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="2"/>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="25" Padding="30,40,30,30" HorizontalOptions="FillAndExpand">

                <Label Text="ASSESSMENT"
                       FontFamily="BrushFont"
                       FontSize="35"
                       TextColor="{StaticResource TextCyan}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <Label Text="{Binding QuestionCounterDisplay}"
                       TextColor="{StaticResource TextCyan}"
                       FontSize="16"
                       FontFamily="ComfortaaRegular"
                       HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 12"
                        Background="{StaticResource CardGradient}"
                        StrokeThickness="0"
                        Padding="25"
                        Margin="0, 20, 0, 20">
                    <VerticalStackLayout Spacing="20">

                        <Label Text="{Binding CurrentQuestion.QuestionText}"
                               TextColor="#0E4D5A"
                               FontSize="18"
                               FontFamily="ComfortaaRegular"
                               VerticalOptions="CenterAndExpand"/>

                        <StackLayout Spacing="10">
                            <Button Text="Strongly disagree (0)"
                                    Command="{Binding SelectOptionCommand}"
                                    CommandParameter="{x:Int32 0}"
                                    BackgroundColor="{Binding CurrentQuestion.SelectedScore, Converter={StaticResource SelectedScoreToColorConverter}, ConverterParameter=0}"
                                    TextColor="White"
                                    FontFamily="ComfortaaRegular"
                                    CornerRadius="8"/>
                            <Button Text="Disagree (1)"
                                    Command="{Binding SelectOptionCommand}"
                                    CommandParameter="{x:Int32 1}"
                                    BackgroundColor="{Binding CurrentQuestion.SelectedScore, Converter={StaticResource SelectedScoreToColorConverter}, ConverterParameter=1}"
                                    TextColor="White"
                                    FontFamily="ComfortaaRegular"
                                    CornerRadius="8"/>
                            <Button Text="Agree (2)"
                                    Command="{Binding SelectOptionCommand}"
                                    CommandParameter="{x:Int32 2}"
                                    BackgroundColor="{Binding CurrentQuestion.SelectedScore, Converter={StaticResource SelectedScoreToColorConverter}, ConverterParameter=2}"
                                    TextColor="White"
                                    FontFamily="ComfortaaRegular"
                                    CornerRadius="8"/>
                            <Button Text="Strongly agree (3)"
                                    Command="{Binding SelectOptionCommand}"
                                    CommandParameter="{x:Int32 3}"
                                    BackgroundColor="{Binding CurrentQuestion.SelectedScore, Converter={StaticResource SelectedScoreToColorConverter}, ConverterParameter=3}"
                                    TextColor="White"
                                    FontFamily="ComfortaaRegular"
                                    CornerRadius="8"/>
                        </StackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                    <Button Text="PREVIOUS"
                            Grid.Column="0"
                            Command="{Binding PreviousCommand}"
                            IsVisible="{Binding IsNotFirstQuestion}"
                            BackgroundColor="{StaticResource ActiveNavColor}"
                            TextColor="White"
                            FontFamily="ComfortaaRegular"
                            CornerRadius="10"
                            HeightRequest="50"/>

                    <Button Text="NEXT"
                            Grid.Column="1"
                            Command="{Binding NextCommand}"
                            IsVisible="{Binding IsNotLastQuestion}"
                            BackgroundColor="{StaticResource ActiveNavColor}"
                            TextColor="White"
                            FontFamily="ComfortaaRegular"
                            CornerRadius="10"
                            HeightRequest="50"/>

                    <Button Text="SUBMIT ASSESSMENT"
                            Grid.ColumnSpan="2"
                            Command="{Binding SubmitCommand}"
                            IsVisible="{Binding IsSubmitVisible}"
                            BackgroundColor="{StaticResource TextCyan}"
                            TextColor="{StaticResource CommentBGColor}"
                            CornerRadius="10"
                            HeightRequest="50"
                            FontFamily="ComfortaaRegular"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" Padding="10,0">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <Button Grid.Column="0" ImageSource="nav_list.png" Command="{Binding NavigateCommand}" CommandParameter="List" AutomationId="List" BackgroundColor="{StaticResource ActiveNavColor}" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                <Button Grid.Column="1" ImageSource="nav_community.png" Command="{Binding NavigateCommand}" CommandParameter="Community" AutomationId="Community" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                <Button Grid.Column="2" ImageSource="nav_diary.png" Command="{Binding NavigateCommand}" CommandParameter="Diary" AutomationId="Diary" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                <Button Grid.Column="3" ImageSource="nav_graph.png" Command="{Binding NavigateCommand}" CommandParameter="Stats" AutomationId="Stats" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                <Button Grid.Column="4" ImageSource="nav_profile.png" Command="{Binding NavigateCommand}" CommandParameter="Profile" AutomationId="Profile" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>