<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mental_Health_Wellness_Tracker.AnalyticPage"
             BackgroundColor="#0B0E23"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextOrange">#FF4500</Color>
            <Color x:Key="ActiveNavColor">#689FBD</Color>
            <Color x:Key="CardBgColor">#1F2442</Color>
            <Color x:Key="TextLight">#E0E0E0</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Main Layout: Content on top, Nav Bar fixed at bottom -->
    <Grid RowDefinitions="*, 80">

        <!-- SCROLLABLE CONTENT -->
        <Grid Grid.Row="0" RowDefinitions="Auto, *">

            <Label 
                Grid.Row="0"
                Text="HISTORY"
                FontFamily="BrushFont"
                FontSize="35"
                TextColor="{StaticResource TextOrange}"
                HorizontalOptions="Center"
                Margin="0,20,0,10"/>

            <CollectionView Grid.Row="1" x:Name="HistoryCollection" Margin="20,0">
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="No records yet." TextColor="Gray" HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 15"
                                BackgroundColor="{StaticResource CardBgColor}"
                                StrokeThickness="0"
                                Padding="15"
                                Margin="0,0,0,15">
                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding TestType}"
                                       TextColor="{StaticResource TextOrange}"
                                       FontAttributes="Bold"
                                       FontSize="16" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DateTaken, StringFormat='{0:MM/dd/yyyy}'}"
                                       TextColor="Gray"
                                       FontSize="12"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding CalculatedResult}"
                                       TextColor="White"
                                       FontSize="14"
                                       Margin="0,5,0,0" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding TotalScore, StringFormat='Score: {0}'}"
                                       TextColor="{StaticResource TextLight}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- BOTTOM NAVIGATION BAR (Button Structure) -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" Padding="10,0">
            <Grid ColumnDefinitions="*,*,*,*,*">

                <!-- 1. Community Button -->
                <Button Grid.Column="0" 
                        ImageSource="nav_community.png" 
                        Clicked="OnNavTapped" 
                        AutomationId="Community" 
                        BackgroundColor="Transparent" 
                        CornerRadius="25" 
                        HeightRequest="55" 
                        WidthRequest="55" 
                        Padding="10"/>

                <!-- 2. List Button -->
                <Button Grid.Column="1" 
                        ImageSource="nav_list.png" 
                        Clicked="OnNavTapped" 
                        AutomationId="List" 
                        BackgroundColor="Transparent" 
                        CornerRadius="25" 
                        HeightRequest="55" 
                        WidthRequest="55" 
                        Padding="10"/>

                <!-- 3. Diary Button -->
                <Button Grid.Column="2" 
                        ImageSource="nav_diary.png" 
                        Clicked="OnNavTapped" 
                        AutomationId="Diary" 
                        BackgroundColor="Transparent" 
                        CornerRadius="25" 
                        HeightRequest="55" 
                        WidthRequest="55" 
                        Padding="10"/>

                <!-- 4. Stats Button (ACTIVE) -->
                <Button Grid.Column="3" 
                        ImageSource="nav_graph.png" 
                        Clicked="OnNavTapped" 
                        AutomationId="Stats" 
                        BackgroundColor="{StaticResource ActiveNavColor}"
                        CornerRadius="25" 
                        HeightRequest="55" 
                        WidthRequest="55" 
                        Padding="10"/>

                <!-- 5. Profile Button -->
                <Button Grid.Column="4" 
                        ImageSource="nav_profile.png" 
                        Clicked="OnNavTapped" 
                        AutomationId="Profile" 
                        BackgroundColor="Transparent" 
                        CornerRadius="25" 
                        HeightRequest="55" 
                        WidthRequest="55" 
                        Padding="10"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>