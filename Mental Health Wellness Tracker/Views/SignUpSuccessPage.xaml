<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mental_Health_Wellness_Tracker.SignUpSuccessPage"
             BackgroundColor="#0B0E23"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryPurple">#8A4FFF</Color>
            <Color x:Key="TextOrange">#FF4500</Color>
            <Color x:Key="TextTeal">#008080</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" 
                         Spacing="10">

        <VerticalStackLayout Spacing="-25" 
                             Rotation="-5" 
                             Margin="0,0,0,50">

            <Label Text="CONGRATULATION"
                   FontFamily="BrushFont" 
                   FontSize="40"
                   TextColor="{StaticResource TextOrange}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <Label Text="NEW"
                   FontFamily="BrushFont" 
                   FontSize="50"
                   TextColor="{StaticResource TextTeal}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TranslationY="-5"/>

            <Label Text="USER!"
                   FontFamily="BrushFont" 
                   FontSize="60"
                   TextColor="{StaticResource TextTeal}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TranslationY="-15"/>
        </VerticalStackLayout>

        <Label Text="ACCOUNT SUCCESSFUL"
               FontFamily="BrushFont"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

        <Label Text="CREATED!"
               FontFamily="BrushFont"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,-5,0,40"/>

        <Button Text="BACK"
                Clicked="OnBackToLoginClicked"
                BackgroundColor="{StaticResource PrimaryPurple}"
                TextColor="Black"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="150"
                HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>