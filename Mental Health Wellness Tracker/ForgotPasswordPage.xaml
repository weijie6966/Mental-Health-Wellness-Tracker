<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mental_Health_Wellness_Tracker.ForgotPasswordPage"
             BackgroundColor="#0B0E23"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InputGray">#F0F0F0</Color>
            <Color x:Key="PrimaryPurple">#8A4FFF</Color>
            <LinearGradientBrush x:Key="VerificationGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00E5FF" Offset="0.0" />
                <GradientStop Color="#64FFDA" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="40,60,40,30" VerticalOptions="Center">

            <Image Source="lock_icon.png" HeightRequest="60" WidthRequest="60" Margin="0,0,0,10"/>

            <Label Text="Reset Password"
                   TextColor="White" 
                   FontAttributes="Bold" 
                   FontSize="24"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="Enter your email to receive a reset link." 
                   TextColor="Gray" 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Label Text="EMAIL" TextColor="White" FontAttributes="Bold" HorizontalOptions="Start"/>
            <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}"
                    HeightRequest="50" StrokeThickness="0">
                <Entry x:Name="EntryEmail" Placeholder="example@email.com" TextColor="Black" Margin="15,0" Keyboard="Email"/>
            </Border>

            <Button Text="SEND RESET LINK"
                    Clicked="OnSendResetLinkClicked"
                    Background="{StaticResource VerificationGradient}"
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>

            <Button Text="BACK TO LOGIN"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>