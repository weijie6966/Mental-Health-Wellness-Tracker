<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mental_Health_Wellness_Tracker.ViewModels"
             x:Class="Mental_Health_Wellness_Tracker.Views.MainPage">



    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InputGray">#F0F0F0</Color>
            <Color x:Key="PrimaryPurple">#8A4FFF</Color>
            <Color x:Key="TextOrange">#FF4500</Color>
            <Color x:Key="TextTeal">#008080</Color>
            <Color x:Key="TextCyan">#00E5FF</Color>

            <Style x:Key="SocialButtonStyle" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 30"/>
                <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="HeightRequest" Value="55"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill"/>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="30,60,30,30" VerticalOptions="Center">

                <VerticalStackLayout Spacing="-25" Rotation="-5" HorizontalOptions="Center" Margin="0,0,0,50">
                    <Label Text="WELCOME" FontFamily="BrushFont" FontSize="50" TextColor="{StaticResource TextOrange}" HorizontalOptions="Center" FontAttributes="Bold"/>
                    <Label Text="USER!" FontFamily="BrushFont" FontSize="60" TextColor="{StaticResource TextTeal}" HorizontalOptions="Center" FontAttributes="Bold" TranslationY="-10"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="EMAIL" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}" HeightRequest="50" StrokeThickness="0">
                            <Entry Text="{Binding Email}" Placeholder="" TextColor="Black" Margin="15,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="PASSWORD" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}" HeightRequest="50" StrokeThickness="0" Padding="15,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0" 
                                       Text="{Binding Password}" 
                                       IsPassword="{Binding IsPasswordEntryHidden}"
                                       Placeholder="" 
                                       TextColor="Black" 
                                       VerticalOptions="Center"/>

                                <ImageButton Grid.Column="1" 
                                             Source="{Binding TogglePasswordImageSource}" 
                                             Command="{Binding TogglePasswordCommand}"
                                             HeightRequest="25" WidthRequest="25" 
                                             VerticalOptions="Center" 
                                             BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="LOG IN" 
                            Command="{Binding LoginCommand}" 
                            BackgroundColor="{StaticResource PrimaryPurple}" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="25" 
                            HeightRequest="50" 
                            WidthRequest="180" 
                            Margin="0,10,0,30" 
                            HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout>

                    <Border Style="{StaticResource SocialButtonStyle}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="CONTINUE WITH GOOGLE" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" FontSize="12"/>
                            <Image Grid.Column="1" Source="google_icon.png" HeightRequest="24" WidthRequest="24"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SocialLoginCommand}" CommandParameter="Google"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource SocialButtonStyle}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="CONTINUE WITH FACEBOOK" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" FontSize="12"/>
                            <Image Grid.Column="1" Source="fb_icon.png" HeightRequest="24" WidthRequest="24"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SocialLoginCommand}" CommandParameter="Facebook"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource SocialButtonStyle}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="CONTINUE WITH APPLE" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" FontSize="12"/>
                            <Image Grid.Column="1" Source="apple_icon.png" HeightRequest="24" WidthRequest="24"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SocialLoginCommand}" CommandParameter="Apple"/>
                        </Border.GestureRecognizers>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,20,0,0">

                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Forgot Password? " TextColor="White" FontSize="13"/>
                                <Span Text="Tap Here!" TextColor="{StaticResource TextCyan}" FontAttributes="Bold" FontSize="13"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Create New Account? " TextColor="White" FontSize="13"/>
                                <Span Text="Tap Here!" TextColor="{StaticResource TextCyan}" FontAttributes="Bold" FontSize="13"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateAccountCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>