<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mental_Health_Wellness_Tracker.ProfilePage"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextCyan">#00E5FF</Color>
            <Color x:Key="ActiveNavColor">#689FBD</Color>

            <LinearGradientBrush x:Key="ProfileCardGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Cyan" Offset="0.0" />
                <GradientStop Color="DeepSkyBlue" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ButtonPrimaryGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DeepSkyBlue" Offset="1.0" />
                <GradientStop Color="Navy" Offset="0.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ButtonSecondaryGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="MidnightBlue" Offset="0.0" />
                <GradientStop Color="DeepSkyBlue" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>

        <Grid>
            <Grid RowDefinitions="*, 80" InputTransparent="{Binding IsMenuVisible}">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="20" Padding="30,30,30,20">

                        <Label Text="PROFILE" FontFamily="BrushFont" FontSize="35" TextColor="{StaticResource TextCyan}" HorizontalOptions="Center" Margin="0,10,0,20"/>

                        <Border StrokeShape="RoundRectangle 40" 
                                HeightRequest="80" WidthRequest="80" 
                                HorizontalOptions="Center" Margin="0,0,0,10"
                                Stroke="White" StrokeThickness="2">
                            <Image x:Name="ImgProfileAvatar" Source="nav_profile.png" Aspect="AspectFill"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" Background="{StaticResource ProfileCardGradient}" StrokeThickness="1" Stroke="#8A2BE2" Padding="20" HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="20">
                                <Label Text="Username" TextColor="Black" FontAttributes="Bold"/>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="Gray" HeightRequest="40">
                                    <Entry x:Name="EntryUsername" Placeholder="Enter your username" TextColor="Black" Margin="10,0"/>
                                </Border>
                                <Label Text="Bio" TextColor="Black" FontAttributes="Bold"/>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="Gray" MinimumHeightRequest="120">
                                    <Editor x:Name="EditorBio" Placeholder="Tell us about yourself..." TextColor="Black" Margin="10" AutoSize="TextChanges"/>
                                </Border>
                                <Image Source="edit_icon.png" HeightRequest="30" WidthRequest="30" HorizontalOptions="Center" VerticalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="SAVE PROFILE" Clicked="OnSaveProfileClicked" Background="{StaticResource ButtonPrimaryGradient}" TextColor="White" FontAttributes="Bold" CornerRadius="30" HeightRequest="60" Margin="0,20,0,0"/>
                        <Button Text="LOGOUT" Clicked="OnLogoutClicked" Background="{StaticResource ButtonSecondaryGradient}" TextColor="White" FontAttributes="Bold" CornerRadius="30" HeightRequest="60" Margin="0,10,0,0" BorderColor="White" BorderWidth="2"/>

                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" Padding="10,0">
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Button Grid.Column="0" ImageSource="nav_community.png" Clicked="OnNavTapped" AutomationId="Community" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                        <Button Grid.Column="1" ImageSource="nav_list.png" Clicked="OnNavTapped" AutomationId="List" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                        <Button Grid.Column="2" ImageSource="nav_diary.png" Clicked="OnNavTapped" AutomationId="Diary" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                        <Button Grid.Column="3" ImageSource="nav_graph.png" Clicked="OnNavTapped" AutomationId="Stats" BackgroundColor="Transparent" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                        <Button Grid.Column="4" ImageSource="nav_profile.png" Clicked="OnNavTapped" AutomationId="Profile" BackgroundColor="{StaticResource ActiveNavColor}" CornerRadius="25" HeightRequest="55" WidthRequest="55" Padding="10"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="MenuOverlay" 
                  IsVisible="False" 
                  BackgroundColor="#80000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped"/>
                </Grid.GestureRecognizers>

                <Border BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15" 
                        WidthRequest="180" 
                        HeightRequest="110"
                        VerticalOptions="Start" 
                        HorizontalOptions="Center" 
                        Margin="100, 130, -100, 0" 
                        Padding="0">

                    <VerticalStackLayout Spacing="0">
                        <Button Text="View Profile" 
                                Clicked="OnViewProfileClicked"
                                TextColor="Black" 
                                BackgroundColor="Transparent" 
                                FontAttributes="Bold"
                                HeightRequest="55"
                                CornerRadius="0"/>

                        <BoxView HeightRequest="1" Color="LightGray"/>

                        <Button Text="Change Profile" 
                                Clicked="OnChangeProfileClicked"
                                TextColor="Black" 
                                BackgroundColor="Transparent" 
                                FontAttributes="Bold"
                                HeightRequest="54"
                                CornerRadius="0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid> </ContentPage>