<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mental_Health_Wellness_Tracker.ViewModels"
             x:Class="Mental_Health_Wellness_Tracker.ForgotPasswordPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:ForgotPasswordViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InputGray">#F0F0F0</Color>
            <Color x:Key="PrimaryPurple">#8A4FFF</Color>
            <Color x:Key="TextCyan">#00E5FF</Color>

            <LinearGradientBrush x:Key="VerificationGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00E5FF" Offset="0.0" />
                <GradientStop Color="#64FFDA" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>

        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="40,60,40,30" VerticalOptions="Center">

                <Image Source="lock_icon.png" HeightRequest="60" WidthRequest="60" Margin="0,0,0,10"/>

                <Label Text="Forgot Password?"
                       TextColor="White" 
                       FontAttributes="Bold" 
                       FontSize="24"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20"/>

                <Label Text="EMAIL" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}"
                        HeightRequest="50" StrokeThickness="2" Stroke="{StaticResource PrimaryPurple}">
                    <Entry Text="{Binding Email}" 
                           Placeholder="" 
                           TextColor="Black" 
                           Margin="15,0"/>
                </Border>

                <Label Text="NEW PASSWORD" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}" HeightRequest="50" StrokeThickness="0" Padding="15,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" 
                               Text="{Binding NewPassword}" 
                               IsPassword="{Binding IsNewPasswordEntryHidden}"
                               TextColor="Black" 
                               VerticalOptions="Center"/>
                        <ImageButton Command="{Binding ToggleNewPasswordCommand}" 
                                     Source="{Binding ToggleNewPasswordImageSource}" 
                                     Grid.Column="1" HeightRequest="25" WidthRequest="25" 
                                     VerticalOptions="Center" 
                                     BackgroundColor="Transparent"/>
                    </Grid>
                </Border>

                <Label Text="CONFIRM PASSWORD" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Border StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}" HeightRequest="50" StrokeThickness="0" Padding="15,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" 
                               Text="{Binding ConfirmPassword}" 
                               IsPassword="{Binding IsConfirmPasswordEntryHidden}"
                               TextColor="Black" 
                               VerticalOptions="Center"/>
                        <ImageButton Command="{Binding ToggleConfirmPasswordCommand}" 
                                     Source="{Binding ToggleConfirmPasswordImageSource}" 
                                     Grid.Column="1" HeightRequest="25" WidthRequest="25" 
                                     VerticalOptions="Center" 
                                     BackgroundColor="Transparent"/>
                    </Grid>
                </Border>

                <Label Text="VERIFICATION CODE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="The code will send to email account" TextColor="White" FontSize="12" HorizontalOptions="Center"/>

                <Grid ColumnDefinitions="*, 10, *" ColumnSpacing="0">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource InputGray}" HeightRequest="50" StrokeThickness="0">
                        <Entry Text="{Binding VerificationCode}" 
                               Placeholder="" 
                               TextColor="Black" 
                               Margin="15,0"/>
                    </Border>

                    <BoxView Grid.Column="1" Color="Transparent"/>

                    <Button Grid.Column="2"
                            Text="SEND"
                            Command="{Binding SendVerificationCommand}"
                            Background="{StaticResource VerificationGradient}"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="50"/>
                </Grid>

                <Button Text="RESET PASSWORD"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="{StaticResource PrimaryPurple}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        WidthRequest="220"
                        Margin="0,20,0,0"
                        HorizontalOptions="Center"/>

                <Button Text="BACK"
                        Command="{Binding BackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        WidthRequest="150"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>